generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  password_hash  String
  created_at     DateTime        @default(now())
  updated_at     DateTime        @updatedAt

  courses        Course[]
  syllabi        Syllabus[]
  schedules      Schedule[]
  calendarEvents CalendarEvent[]
  studyBlocks    StudyBlock[]
  focusSessions  FocusSession[]
  focusMetrics   FocusMetric[]
  settings       UserSettings?

  @@map("users")
}

model Course {
  id          String   @id @default(uuid())
  user_id     String
  title       String
  course_code String?
  instructor  String?
  semester    String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user        User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  syllabi     Syllabus[]
  tasks       Task[]
  schedules   Schedule[]
  studyBlocks StudyBlock[]

  @@map("courses")
}

model Syllabus {
  id              String   @id @default(uuid())
  user_id         String
  course_id       String?
  course_name     String?
  filename        String?
  extracted_text  String   @db.LongText
  analysis_status String   @default("pending")
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  user        User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course?  @relation(fields: [course_id], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@map("syllabi")
}

model Task {
  id                 String    @id @default(uuid())
  syllabus_id        String?
  course_id          String?
  title              String
  type               String?
  deadline           DateTime?
  is_date_only       Boolean   @default(false)
  weight             Float?
  estimated_duration Int?
  description        String?   @db.Text
  recurring          Boolean   @default(false)
  status             String    @default("pending")
  needs_review       Boolean   @default(true)
  version            Int       @default(1)
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  syllabus    Syllabus? @relation(fields: [syllabus_id], references: [id], onDelete: Cascade)
  course      Course?   @relation(fields: [course_id], references: [id], onDelete: Cascade)
  studyBlocks StudyBlock[]

  @@map("tasks")
}

model Schedule {
  id         String   @id @default(uuid())
  user_id    String
  course_id  String?
  status     String   @default("active")
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user        User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  course      Course?      @relation(fields: [course_id], references: [id], onDelete: Cascade)
  studyBlocks StudyBlock[]

  @@map("schedules")
}

model CalendarEvent {
  id         String   @id @default(uuid())
  user_id    String
  title      String
  start_time DateTime
  end_time   DateTime
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("calendar_events")
}

model StudyBlock {
  id          String   @id @default(uuid())
  user_id     String
  schedule_id String?
  task_id     String?
  course_id   String?
  title       String
  start_time  DateTime
  end_time    DateTime
  status      String   @default("pending")
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  user          User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  schedule      Schedule?    @relation(fields: [schedule_id], references: [id], onDelete: Cascade)
  task          Task?        @relation(fields: [task_id], references: [id], onDelete: SetNull)
  course        Course?      @relation(fields: [course_id], references: [id], onDelete: Cascade)
  focusSessions FocusSession[]

  @@map("study_blocks")
}

model FocusSession {
  id             String   @id @default(uuid())
  user_id        String
  study_block_id    String?
  task_id           String?
  start_time        DateTime
  end_time          DateTime?
  planned_minutes   Int
  actual_minutes    Int      @default(0)
  status            String   @default("ACTIVE")
  paused_at         DateTime?
  accumulated_pause Int      @default(0)
  created_at        DateTime @default(now())

  user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  studyBlock     StudyBlock?   @relation(fields: [study_block_id], references: [id], onDelete: SetNull)
  focusMetrics   FocusMetric[]

  @@map("focus_sessions")
}

model FocusMetric {
  id         String        @id @default(uuid())
  user_id    String
  session_id String?
  metric_key String
  value      Float
  created_at DateTime      @default(now())

  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  session    FocusSession? @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@unique([session_id, metric_key])
  @@map("focus_metrics")
}

model JobRecord {
  id         String   @id @default(uuid())
  status     String
  logs       String?  @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("job_records")
}

model UserSettings {
  id                   String   @id @default(uuid())
  user_id              String   @unique
  timezone             String   @default("Asia/Colombo")
  start_hour           Int      @default(8)
  end_hour             Int      @default(22)
  max_session_duration Int      @default(90)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  user                 User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("user_settings")
}
